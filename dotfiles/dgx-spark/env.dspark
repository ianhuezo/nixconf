# DeepSeek V4 Flash DSpark C12 NVFP4 — 2x ASUS Ascent GX10 (TP=2)
# node1 gx10-64b7 = head   169.254.34.131
# node2 gx10-08bb = worker 169.254.54.207
# Node-specific values (NODE_RANK / HEADLESS) are rewritten on the worker.

# Cluster
WORKER_HOST=169.254.54.207
WORKER_DIR=
WORKER_SCRIPT_DIR=
MASTER_ADDR=169.254.34.131
MASTER_PORT=25000
NODE_RANK=0
HEADLESS=

# RoCE / InfiniBand
# GID index 3 = RoCE v2 / IPv4 (gid ...ffff:a9fe:2283 -> 169.254.34.131).
# Index 0/1 are link-local, index 2 is RoCE v1 — all wrong for this fabric.
NCCL_IB_HCA=rocep1s0f1
NCCL_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_GID_INDEX=3
NCCL_CROSS_NIC=1

# Caches / model
HF_CACHE=${HOME}/.cache/huggingface
WORKER_HF_CACHE=
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
HF_HUB_DISABLE_XET=1
# Official GA checkpoint. REQUIRES patches/0004-dspark-shared-expert-gate-up-proj.patch
# (+69% decode: 32.7 -> 55.4 tok/s mean, acceptance 25.7% -> 60.2%).
DSPARK_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# API
VLLM_PORT=8888
SERVED_MODEL_NAME=deepseek-v4-flash-dspark
# 0.0.0.0 so the agent harness on the LAN box can reach it.
VLLM_HOST=0.0.0.0
VLLM_HOST_IP=169.254.34.131
WORKER_VLLM_HOST_IP=169.254.54.207

# Runtime image built by ./build-dspark-vllm-runtime.sh
DSPARK_VLLM_IMAGE=vllm-dspark-runtime:dspark-nvfp4-stage-c

# Validated Keys C12 NVFP4 profile (1M true YaRN ceiling)
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=12
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.85
MTP_NUM_TOKENS=5

# DSpark / B12X switches
VLLM_USE_FLASHINFER_SAMPLER=1
# CRITICAL: =0 silently falls back to DEEPGEMM_MXFP4 and tanks decode to ~29 tok/s.
VLLM_USE_B12X_MOE=1
VLLM_USE_B12X_WO_PROJECTION=1
VLLM_DSPARK_CONFIDENCE_THRESHOLD=0.0
VLLM_DSPARK_CONFIDENCE_SCHEDULER=off
VLLM_DSPARK_LOCAL_ARGMAX=1
VLLM_DSPARK_REPLICATE_MARKOV_W1=1
VLLM_DSPARK_FUSED_MARKOV_ARGMAX=0
VLLM_DSPARK_GPU_REJECTED_CONTEXT_MASK=1
VLLM_DSPARK_REFERENCE_KV_QUANT_DEQUANT=0
VLLM_DSPARK_HARDWARE_SCHEDULER_EARLY_STOP=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
