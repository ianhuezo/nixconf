# Entrpi/glm-5.3-flash-exl3-2x-spark -> ~/glm-5.3-flash-exl3-2x-spark/.env on node1.
# Deployed by ../deploy.sh. Upstream ships .env.example; this is that file with
# this pair's real topology filled in. Only the deltas are commented.

# --- the two boxes ----------------------------------------------------------
# NOT the LAN address, despite the name. node1's LAN path to node2 is WiFi
# (wlP9s9, 192.168.50.0/24) and its host key for 192.168.50.179 is unknown, so
# every WSSH call would fail. Pointing this at the rail fixes both: the worker
# hardware checks, the 25 GiB `docker save | ssh docker load` image ship and the
# rsync all run over the 200 Gb/s QSFP link instead of contended WiFi.
WORKER_LAN_IP=169.254.54.207
WORKER_USER=ian

# The CX7 rail. Link-local /16, not the reference kit's 10.200.0.0/24 -- these
# are the addresses ../glm53/env.glm53 already rendezvouses NCCL on, so they are
# known-good on this pair.
HEAD_RAIL_IP=169.254.34.131
WORKER_RAIL_IP=169.254.54.207
# f1/np1, not the upstream default f0/np0: the QSFP cable is in the second port.
HEAD_NCCL_IF=enp1s0f1np1
HEAD_NCCL_HCA=rocep1s0f1
WORKER_NCCL_IF=enp1s0f1np1
WORKER_NCCL_HCA=rocep1s0f1
NCCL_SUBNET=169.254.0.0/16

# --- weights ----------------------------------------------------------------
# nfs. local was tried twice and OOM-killed the head both times at shard
# 114/120 (~95%), matching upstream's documented ~90% wedge.
#
# vLLM states the problem itself in the boot log:
#   Checkpoint size: 163.58 GiB. Available RAM: 100.50 GiB.
# TP slicing happens at load time, so EACH rank streams the FULL 163.58 GiB and
# keeps only its ~82 GiB half. The discarded half lands in page cache faster
# than NVRM's bounded reclaim can evict it, the kernel swaps anonymous pages to
# compensate, and the loader dies. Only the head is affected: it carries the
# API server too, which is what drops its available RAM to ~100 GiB.
#
# Dropping caches on a timer was tried and is NOT sufficient -- it delayed the
# swap ratchet to ~50% but could not clear mmap'd pages, and the head still
# died at 114/120. The volume gap is ~80 GiB; no eviction cadence closes it.
#
# NFS is not merely a throttle here: that same log line shows vLLM's loader
# explicitly branches on network filesystems ("not a recognized network FS
# (NFS/Lustre)"), so this changes the load path, not just its pace.
#
# Getting --nfs to work on GB10 needed three upstream fixes plus a runtime
# change -- see nfs-arm64/README.md. Bring nfs-exl3 up BEFORE install.sh --nfs.
WEIGHTS_MODE=nfs
MODEL_HOST_PATH=          # empty = $HOME/models/glm53-exl3
DFLASH_DIR=               # empty = $HOME/models/glm53-dflash2
EXL3_REPO=brandonmusic/GLM-5.3-Flash-tr3-4bpw
EXL3_REPO_FALLBACK=Mia-AiLab/GLM-5.3-Flash-EXL3-TR3-4bpw
DFLASH_REPO=incoai/GLM-5.3-Flash-DFlash2

# Host networking on the NFS container means no port mapping, so the export is
# on 2049 rather than upstream's mapped 12049. See nfs-arm64/README.md.
NFS_PORT=2049

# --- image ------------------------------------------------------------------
IMAGE=ghcr.io/entrpi/glm-5.3-flash-exl3-2x-spark:v1-dflash2

# --- serving knobs ----------------------------------------------------------
# 8888, not upstream's 8000: models.yml, model-select.sh, spark-model-watchdog
# and vllm-stats.sh all address the pair on 8888, and only one model is ever
# resident so there is nothing to collide with.
PORT=8888

# MAX_LEN / MAX_SEQS are NOT set here. install.sh does not propagate them into
# ~/.glm53-serve.env, and the README's way to set them is on both launches --
# so they live in start-glm53-exl3.sh, which owns both. Current profile there:
# MAX_LEN=358400 MAX_SEQS=5, upstream's documented "more concurrency headroom"
# row (1,275,306-token pool = 3.56 full banks) rather than the 524k default,
# whose 2.74 banks fall under the c3 floor this deployment needs.
#
# Everything below is left at the launcher's defaults deliberately -- that is
# the "shipped-image default" profile: DFlash2 k=7, fp8_e4m3 KV, CUDA graphs,
# fully baked into v1-dflash2 and quality-gated by upstream.
#
# The README's *ratified* default is the GLM_NEXT b12x lane
# (ATTN_BACKEND=B12X_MLA_SPARSE + KV_DTYPE=fp8_ds_mla + KV_SKIP_LAYERS), which
# scores better on every gate -- but on this image it requires hotfix overlays
# (fork @5c9e2bfd2 + b12x glm-next-backport) that upstream has not published as
# a build. Do not set the trio here until that image ships; a partial set boots
# into a backend/KV mismatch.
#MAX_LEN=524288
#KV_DTYPE=fp8_e4m3
#KV_CACHE_MEMORY=          # empty -> 12.4e9 validated; do NOT raise without
                           # re-running tools/memlog.sh (13.4e9 collapsed the
                           # measured free floor from 5.25 GiB to 2.26 GiB)
#MAX_SEQS=4
#GMU=0.85
