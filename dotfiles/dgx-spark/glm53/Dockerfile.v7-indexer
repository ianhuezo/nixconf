ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Indexer hardening (the second NaN class): the kpool top-k destination was
# torch.empty and the top-k kernels only guarantee the first min(k, valid)
# entries, so rows with fewer valid pools carried uninitialized pool ids ->
# in-range-but-bogus token indices -> MLA gathers uninitialized KV -> NaN
# lottery. Init to -1 and clamp the pool expansion.
LABEL org.local.glm53.stage="v7-indexer-hardening"

COPY patches/patch_v7_indexer.py /tmp/patch.py
RUN python3 /tmp/patch.py && rm /tmp/patch.py
