# GLM-5.3-Flash NVFP4 on the DGX Spark pair. Deployed to both nodes as
# ~/dspark-recipe/glm53/.env.glm53 by ../deploy.sh, which flips NODE_RANK and
# HEADLESS on the worker.
#
# Fabric values are copied from ../env.dspark on purpose: same two nodes, same
# NICs, already proven by the DeepSeek deployment. Tony's recipe uses the f0
# NIC and NCCL_CROSS_NIC=0 because that is his topology, not because GLM needs it.

WORKER_HOST=169.254.54.207
WORKER_DIR=
WORKER_SCRIPT_DIR=
MASTER_ADDR=169.254.34.131
# Deliberately not DeepSeek's 25000: a lingering socket from the model you just
# switched away from should not be able to poison the rendezvous.
MASTER_PORT=25100
NODE_RANK=0
HEADLESS=

NCCL_IB_HCA=rocep1s0f1
NCCL_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_GID_INDEX=3
NCCL_CROSS_NIC=1

HF_CACHE=${HOME}/.cache/huggingface
WORKER_HF_CACHE=
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
HF_HUB_DISABLE_XET=1

# 185.7 GiB of weights across 47 shards, ~93 GiB per rank at TP2.
#
# Given as a repo id, but the container resolves it to the HF cache's snapshot
# DIRECTORY before launching, and that is load-bearing rather than cosmetic.
# vLLM resolves repo ids fine for weights, but the GLM5 multimodal processor
# does a bare open(os.path.join(model, "processor_config.json")) -- no hub
# lookup -- so a repo id crashes the API server on startup with FileNotFoundError
# once vision is enabled. An absolute path here is passed through untouched.
GLM53_MODEL=local-inference-lab/GLM-5.3-Flash-NVFP4

VLLM_PORT=8888
SERVED_MODEL_NAME=glm-5.3-flash
VLLM_HOST=0.0.0.0
VLLM_HOST_IP=169.254.34.131
WORKER_VLLM_HOST_IP=169.254.54.207

GLM53_BASE_IMAGE=vllm/vllm-openai:glm53-flash-arm64-cu130
GLM53_VLLM_IMAGE=vllm-glm53-runtime:sm121-v14

# jack6464's measured TP2 profile (NVIDIA forum, GLM-5.3-Flash thread post 22):
# 200,000-token limit with an 848,717-token KV pool = 4.24x 200K contexts, so
# four full-length sessions are guaranteed and a fifth fits whenever the
# resident contexts are short -- which is why MAX_NUM_SEQS is 5, not 4.
#
# Whether we actually get that pool depends on the engine (see the note on
# GPU_MEMORY_UTILIZATION). vLLM prints the real number at boot:
#   GPU KV cache size: N tokens
#   Maximum concurrency for 200,000 tokens per request: Nx
# If that ratio comes back below ~4x, lower MAX_MODEL_LEN until it does --
# concurrency is exactly pool / MAX_MODEL_LEN.
MAX_MODEL_LEN=200000
# 5, matching omp's task.maxConcurrency -- the client never sends more, so a
# higher ceiling would be a number that never gets used.
#
# The MTP-off pool (1,943,396 tokens) would technically seat 9 at 200K, but that
# is 93% pool utilisation, and on GB10 the failure mode at high utilisation is
# phantom backing: reservations that succeed and then fault when load touches
# the pool's far edges. Upstream's residual-headroom rule is to keep ~8-10 GB
# free. Five seats sit at 51%, which is where the gates were run.
MAX_NUM_SEQS=5

# Small prefill batches are what keep long prefills alive at gmu 0.90: they cap
# the activation transient that would otherwise NVRM-OOM the engine mid-prefill.
# With 2048, jack6464 completed a real 180,013-token request.
MAX_NUM_BATCHED_TOKENS=2048

# NOT a tuning knob. vLLM's hybrid block aligner picks 2176 on this backend,
# whose kpool storage tiles by 32, but DeepGEMM's arch-12 fp8 paged-MQA accepts
# only 64-entry pool pages. 2304 is a multiple of both kpool*64 and the MLA 128
# alignment. Changing it reintroduces an assert death in warmup.
BLOCK_SIZE=2304

# 0.78 and 0.80 both starve the KV cache on this model; 0.85 was Tony's ceiling
# on the FlashInfer-SM90 backend, and 0.90 is jack6464's on the native SM12x
# path. 0.90 only holds together because MAX_NUM_BATCHED_TOKENS caps the
# prefill transient -- raise one without the other and long prefills OOM.
#
# Caveat worth knowing before tuning: jack6464's 848,717-token pool was measured
# on a "native SM12x extension" build he does not identify, plus InstantTensor
# loading. This image is Tony's FlashInfer-SM90-extended-to-SM121 stack, whose
# measured pool was 507,041. Expect something between the two, and trust the
# number vLLM prints over either.
GPU_MEMORY_UTILIZATION=0.90

KV_CACHE_DTYPE=fp8_e4m3

# THE number to tune, and the only one that matters for stability.
#
# GB10 has no VRAM: every GPU allocation is host DRAM through the NVIDIA kernel
# driver, whose allocation path fails fast rather than reclaiming clean page
# cache. Meanwhile vLLM reports "free memory" as psutil available, which counts
# reclaimable page cache -- so it cheerfully suggests pools the driver cannot
# deliver. Upstream's ladder: 4.14 GiB worked 3/3, and every one of 5 attempts
# at >=5.5 GiB killed a rank with NVRM: NV_ERR_NO_MEMORY.
#
# 4445787956 = 4.14 GiB = ~507K fp8 tokens on Tony's 181 GiB quant. Our quant is
# 4.4 GiB larger (~2.2 GiB more per rank), so vLLM may compute a smaller safe
# budget. Take the number vLLM prints in its own startup log -- it is not
# advisory -- and set it here. Empty = let vLLM choose, which is the safe start.
KV_CACHE_MEMORY=

# Which speculative decoder, if any: none | mtp | dflash.
#
# dflash. A separate 2.3 GiB block-diffusion drafter
# (incoai/GLM-5.3-Flash-DFlash2) rather than the checkpoint's own MTP head. It
# proposes a whole 8-token block and refines it, instead of re-running a single
# nextn layer autoregressively, so it sustains much longer accepted runs.
#
# Measured HERE (not copied), thinking on except where noted, against the
# 14.62 tok/s no-drafter baseline:
#
#   structured list (count 1-200)   52.85 tok/s   90.1% accepted   7.55/step
#   JSON tool arguments             27.33          29.9%           3.08
#   Python source                   26.94          33.3%           3.33
#   prose, thinking off             25.50          29.8%           3.10
#   prose, thinking on              22.09          25.3%           2.80
#
#   c1 23.38 tok/s (was 14.62, +60%)   c5 aggregate 56.37 (was 52.43, +7.5%)
#
# Upstream reports 46.9 tok/s on a code prompt at 74.1% acceptance; we get 33%
# on code. The wiring is not the difference -- 90% acceptance on structured
# output rules out the miswired-glue signature, which pins acceptance near 15%
# on EVERY regime. The remaining suspects are the quant (we serve
# local-inference-lab, upstream serves LibertAIDAI, and the drafter was trained
# against the bf16 target) and prompt predictability. Not worth chasing: the
# regimes agents actually generate are already covered above.
#
# What this does NOT buy is KV pool. Per-BLOCK pool bytes are unchanged -- the
# drafter's sliding-window layers slot-share the MLA tensors like GLM's mamba
# layers, and the build's simulation asserts it -- but the drafter's weights and
# workspace come out of the same unified-memory budget the KV slab is carved
# from: 1,547,169 tokens without it, 832,941 with (4.16x at 200K). That is a
# similar bill to MTP's ~4.3 GiB. DFlash2 wins on throughput, not on memory.
#
# Set none to fall back to the plain decoder, mtp to use the checkpoint's head.
SPEC_METHOD=dflash

# The drafter checkpoint. Resolved to its HF cache snapshot directory inside the
# container, same as GLM53_MODEL. Fetch it onto BOTH ranks with
# `./fetch-glm53-weights.sh draft` -- a drafter present on only one rank is a
# rank-1 death 15 minutes into a boot with nothing useful in the head's log.
DFLASH2_MODEL=incoai/GLM-5.3-Flash-DFlash2

# NOT a tuning knob: block_size - 1. The drafter's config.json says
# dflash_config.block_size = 8, and one position of every block is the target's
# own verified token, so 7 is the number of positions it was trained to fill.
# Asking for 8 drafts a position the model never learned.
DFLASH2_NUM_TOKENS=7

# ---- MTP (only used when SPEC_METHOD=mtp) --------------------------------
# Speculative draft depth. 3 -- derived, not copied.
#
# Throughput = accepted_tokens / (1 + N*f), where f is a draft pass's cost
# relative to a full forward pass. Solved from measurements on THIS pair:
#   MTP=5 -> 2.09 accepted/round, 14.25 tok/s vs 14.62 without  =>  f ~= 0.23
# and from jack6464's published pair (3.57 accepted, 23.08 vs 14.48) => f ~= 0.248.
# Nearly identical, so the draft machinery costs the same on both stacks. The
# only real difference is ACCEPTANCE -- and his 3.57 was measured on
# tool-calling traffic (highly predictable) while our 2.09 was on open prose.
# Different workloads, not different engines.
#
# Fitting a per-position acceptance curve to each measured total and maximising:
#              prose (ours)   agentic (his)
#     N=1         1.21x          1.48x
#     N=2         1.21x          1.66x
#     N=3         1.15x        * 1.70x *
#     N=5         0.97x          1.61x    <- both measured; the model retrodicts
#                                            both, which is why it is trusted
#
# 3 is optimal for agentic traffic and near-optimal for prose. 5 -- used by the
# forum post AND the official vLLM recipe -- is the worst choice on BOTH curves;
# it was inherited, not derived. GLM-5.2's production config and Tony's own
# report independently land on 3 as well.
#
# Also note vLLM warns that N>1 re-runs the single MTP layer
# (num_nextn_predict_layers=1) autoregressively, which depresses acceptance --
# another argument against deep speculation on this checkpoint.
#
# N does NOT change memory: the ~4.3 GiB cost is for loading the draft head at
# all (14.69 -> 10.39 GiB available; 1,943,396 -> 1,121,212 tokens). MTP is a
# binary pool decision, and 1.12M still holds 5.61x 200K contexts, so five
# agents at full context fit either way. Set 0 to recover the larger pool.
# Kept at 0 because SPEC_METHOD=dflash; this only takes effect under
# SPEC_METHOD=mtp, where 3 is the derived optimum.
#
# Measured on this pair, for multi-agent throughput MTP loses on both axes:
#           c1 solo   c5 aggregate   KV pool      slots @200K
#   off      14.62       52.43       1,943,396       9.7
#   N=3      17.22       45.59       1,093,333       5.5
#   N=5      13.54       37.89       1,121,212       5.6
#
# MTP buys single-stream latency (+18% at N=3) and pays for it twice at
# concurrency: speculation competes with a full batch, AND the draft head costs
# ~4.3 GiB, halving the concurrent slots. Turn it on only if one interactive
# agent's responsiveness matters more than aggregate -- N=1 or 2 would be the
# tune then (fitted optimum ~1.35x, ~19-20 tok/s solo), NOT 5.
#
# Root cause of the weak payoff: a draft pass costs ~45% of a full 45-layer
# forward pass (solved consistently from both the N=3 and N=5 measurements),
# almost certainly the fixed inter-node all-reduce over the fabric, which a
# one-layer draft cannot amortise. That ceiling is structural to TP2-across-two-
# machines, not a tuning problem.
MTP_NUM_TOKENS=0

# marlin. b12x was investigated thoroughly and is NOT viable here -- the reason
# is memory, not correctness, and it is worth recording so nobody retries it.
#
# The native SM12x FP4 MoE kernel (FLASHINFER_B12X / b12x_fused_moe, FlashInfer
# PR #3080) fuses dispatch + both GEMMs + SwiGLU + topk into one kernel and
# quantizes BF16->FP4 in-kernel, removing marlin's dequant-to-BF16 round trip on
# every routed-expert matmul. Two real upstream bugs blocked it; BOTH ARE FIXED
# in this image (patches v12 and v13) and it now loads:
#
#   v12 -- FlashInfer applies the SwiGLU clamp only on the swigluoai branch, so
#          a silu model with swiglu_limit (GLM: 10.0) would compute UNCLAMPED
#          activations. vLLM's refusal was correct; v12 wires the clamp into the
#          silu path, plumbs swiglu_limit through, and updates the oracle.
#   v13 -- the SM12x MoE kernels borrow unbound methods from the dense GEMM
#          kernel with their own `self` but omit _collapse_to_vmk, which the
#          borrowed _partition_fragment_SFA/SFB call. AttributeError at init.
#
# It still cannot be used, and this was MEASURED on this pair rather than
# assumed. Booting b12x wedged the head node ~16 minutes in, exactly when
# process_weights_after_loading runs. journalctl -b -1 -k:
#
#   04:53:00 NVRM: Out of memory [NV_ERR_NO_MEMORY] from
#            _memdescAllocInternal @ mem_desc.c:1359   (x15, through 04:58)
#   04:58:20 snapd: page allocation failure; Free swap 8.8G of 16.8G
#   05:00-05:02 systemd-journald: "Under memory pressure, flushing caches"
#
# Cause: FlashInferB12xExperts converts every weight scale factor to MMA layout
# and CACHES it (w1_sf_mma / w2_sf_mma) alongside the originals. At NVFP4
# group_size 16, ~300B expert params carry ~18.75B scale values ~= 9.4 GB per
# rank, held twice during conversion. With 92 GiB of weights already resident
# and ~12 GiB of headroom at gmu 0.90, there is nowhere to put it.
#
# Lowering gpu-memory-utilization enough to fit would consume essentially the
# whole KV pool (2,049,056 tokens / 10.25x at 200K on marlin), trading
# concurrency for a faster kernel -- the wrong trade for multi-agent serving.
#
# Conclusion: b12x needs a smaller model or a larger machine. The v12/v13
# patches are still correct and worth reporting upstream; keep them so this is
# re-testable if FlashInfer ever frees the original scales after conversion.
MOE_BACKEND=marlin

# Vision. GLM-5.3-Flash is natively multimodal (24-layer ViT, 448px, patch 14)
# and this quant's shipped chat_template.jinja already emits the placeholders
# vLLM's multimodal processor scans for -- <|begin_of_image|><|image|>
# <|end_of_image|> and the video equivalent -- so NO --chat-template override
# is needed here. That is specific to this quant: the LibertAIDAI checkpoint
# Tony deployed ships a text-only template that renders images as an "unable to
# process this image" reminder string, which is why his recipe carries a
# chat_template_mm.jinja. Ours does not need one.
#
# jack6464's verified multimodal limits. He needed a chat-template fix to get
# here ("At most 0 image(s)"); we do not, per the note above.
#
# vLLM profiles startup memory against these limits, so on a box this
# memory-tight they are partly a KV-budget decision. If the KV pool comes back
# smaller than expected, these are worth trying at 2/0 before touching MTP.
MM_LIMIT_IMAGE=8
MM_LIMIT_VIDEO=1

# LRU cache for decoded multimodal inputs, so a repeated image in a
# conversation is not re-processed every turn. Blank it if the engine in the
# image predates the flag -- an unknown CLI arg is a boot failure, not a warning.
MM_PROCESSOR_CACHE_TYPE=lru

# Escape hatch: appended verbatim to the vllm serve command. Use it to try a
# flag without editing the compose file.
#
# MUST be quoted if it contains spaces. The launcher does `set -a; source` on
# this file, so an unquoted `--load-format dummy` parses as an assignment
# followed by a command named "dummy" -- which aborts the launcher under set -e.
EXTRA_VLLM_ARGS=""

TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
VLLM_ENGINE_READY_TIMEOUT_S=3600
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Container memory ceiling, for unproven memory profiles only. Empty/0 =
# unlimited. 112g leaves ~9 GiB for the host so a runaway allocation kills the
# container instead of wedging the node into swap (see the compose comment).
GLM53_MEM_LIMIT=
