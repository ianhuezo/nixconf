+import { session } from "electron";
+
+import { VencordSettings } from "./settings";
+
+export function registerYoutubeEmbedRefererHandler() {
+    session.defaultSession.webRequest.onBeforeSendHeaders(
+        { urls: ["https://www.youtube.com/embed/*", "https://www.youtube-nocookie.com/embed/*"] },
+        ({ resourceType, requestHeaders }, callback) => {
+            if (
+                resourceType === "subFrame" &&
+                VencordSettings.store.plugins?.FixYoutubeEmbeds?.enabled &&
+                /^https:\/\/([a-z]+\.)?discord\.com\//.test(requestHeaders.Referer ?? "")
+            )
+                requestHeaders.Referer = "https://www.google.com/";
+
+            callback({ requestHeaders });
+        }
+    );
+}
